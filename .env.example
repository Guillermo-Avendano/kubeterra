# ======================================================
# KubeTerra Environment Configuration Template
# ======================================================
# Copy this file to .env.local and update with actual values
# NEVER commit .env.local to version control
#
# Usage:
#   cp .env.example .env.local
#   vim .env.local  # Update with your values
#   source .env.local
#   ./05_terraform.sh

# ======================================================
# KUBERNETES CONFIGURATION
# ======================================================
NAMESPACE=mobius
KUBECONFIG_PATH=~/.kube/config

# ======================================================
# REGISTRY CONFIGURATION
# ======================================================
# Source registry for pulling images
KUBE_SOURCE_REGISTRY=registry.rocketsoftware.com

# Local registry port
LOCAL_REGISTRY_PORT=5000

# Registry URL (auto-detected WSL IP or set manually)
# REGISTRY_URL=<wsl_ip>:5000

# ======================================================
# IMAGE VERSIONS AND REGISTRY
# ======================================================
# These image versions should match conf/images.csv for consistency
# Format: IMAGE_NAME:TAG (e.g., mobius-server:12.5.2)
#
# Note: Also used by 04_pullimages.sh to pre-pull images
# Update these to match your deployment versions

# Mobius Server image version (from images.csv)
# Variable used: var_mobiusserver_image (in terraform)
MOBIUS_SERVER_IMAGE=12.5.2

# Mobius View image version (from images.csv)
# Variable used: var_mobiusview_image (in terraform)
MOBIUS_VIEW_IMAGE=12.5.2

# Event Analytics image version (from images.csv)
# Variable used: var_eventanalytics_image (in terraform)
EVENT_ANALYTICS_IMAGE=2.0.9

# Smart Chat image version (from images.csv)
# Variable used: var_smart_chat_image (in terraform)
SMART_CHAT_IMAGE=1.2.8

# Smart Chat Query Logs image version (from images.csv)
# Variable used: var_smart_chat_query_logs_image (in terraform)
SMART_CHAT_QUERY_LOGS_IMAGE=1.2.2

# Smart Chat Indexing Proxy image version (from images.csv)
# Variable used: var_smart_chat_indexing_proxy_image (in terraform)
SMART_CHAT_INDEXING_PROXY_IMAGE=1.2.2

# Docker registry URL for pulling images
# If using local registry:
DOCKER_REGISTRY=localhost:5000
# If using Rocket Software registry:
# DOCKER_REGISTRY=registry.rocketsoftware.com

# ======================================================
# DOCKER REGISTRY CREDENTIALS
# ======================================================
# Required: Docker registry credentials for pulling images
DOCKER_USERNAME=<your_registry_username>
DOCKER_PASSWORD=<your_registry_password>
DOCKER_EMAIL=<your_email>

# Docker registry URL (if using local registry)
# DOCKER_REGISTRY=localhost:5000
# For Rocket Software registry:
# DOCKER_REGISTRY=registry.rocketsoftware.com

# ======================================================
# STORAGE CONFIGURATION
# ======================================================
# Storage class for Persistent Volume Claims
PVC_STORAGE_CLASS=nfs-storage
# Requested capacity for Persistent Volume Claims
PVC_STORAGE_CAPACITY=1Gi

# ======================================================
# MOBIUS LICENSE
# ======================================================
# Required: Mobius license key
MOBIUS_LICENSE=<your_mobius_license_key>

# ======================================================
# SMART CHAT CONFIGURATION
# ======================================================
# Optional: OpenAI API key for Smart Chat integration
OPENAI_KEY=<your_openai_api_key>

# ======================================================
# DATABASE CONFIGURATION
# ======================================================
# Database hostname or IP
DATABASE_HOSTNAME=postgresql.shared-services.svc.cluster.local

# Database credentials
DATABASE_USER=postgres
DATABASE_PASSWORD=<your_database_password>

# Database port
DATABASE_PORT=5432

# ======================================================
# ADVANCED OPTIONS (Optional)
# ======================================================
# Uncomment and modify if needed

# Terraform Debug Logging (very verbose, use for troubleshooting)
# Set to DEBUG for detailed terraform execution logs
TF_LOG=DEBUG

# Use local Kubernetes cluster (true/false)
# VAR_USE_LOCALKUBE=true

# Deploy PostgreSQL within namespace (true/false)
# VAR_DEPLOY_POSTGRESQL=true

# Smart Chat OpenSearch configuration
# VAR_OPENSEARCH_USER=admin
# VAR_OPENSEARCH_PASSWORD=<secure_password>

# Image versions (uncomment to override defaults)
# VAR_MOBIUS_SERVER_IMAGE=12.5.2
# VAR_MOBIUS_VIEW_IMAGE=12.5.2
# VAR_EVENT_ANALYTICS_IMAGE=2.0.9
# VAR_SMART_CHAT_IMAGE=1.2.8

# ======================================================
# CI/CD PIPELINE VARIABLES (Optional)
# ======================================================
# Set these for automated deployments

# TERRAFORM_BACKEND_TYPE=kubernetes  # or s3, azurerm, etc.
# TF_LOG=INFO  # Set to DEBUG for verbose logging
# TF_LOG_PATH=terraform.log
